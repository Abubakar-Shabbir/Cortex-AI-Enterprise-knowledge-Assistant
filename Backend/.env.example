# Copy this file to .eee and fill in real values.
# Never commit .eee - it's already in .gitignore.
#
# See DEPLOYMENT.md for exactly where each of these values comes from
# on a free-tier deployment (Supabase / Render / a free SMTP provider /
# a free LLM provider).

# ==========================================
# Core Django
# ==========================================

# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Must be False in any deployed environment - True is for local dev only.
DEBUG=True

# Comma-separated. Local dev works out of the box; a real deployment
# must list its actual domain (e.g. your-app.onrender.com).
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, each with an explicit http:// or https:// scheme -
# Django's CSRF check requires it. Must include your real domain in
# production (e.g. https://your-app.onrender.com).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# SPA origins allowed to call Django /api with credentials (direct, no Vite proxy).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Database (PostgreSQL + pgvector)
# ==========================================
# Local dev: docker-compose.yml's postgres service (sslmode prefer, no
# SSL configured there). Production: Supabase's connection values (see
# DEPLOYMENT.md) - set DB_SSLMODE=require there.
#
# Railway: leave DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT unset and
# set DATABASE_URL instead (settings.py auto-detects it and skips the
# discrete vars entirely - see the DATABASES block there). Railway's
# Postgres plugin exposes it as a reference variable, e.g.
# DATABASE_URL=${{Postgres.DATABASE_URL}} on the backend service - no
# manual copy/paste of host/user/password needed.

DB_NAME=rag_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
CONN_MAX_AGE=60
# DATABASE_URL=

# ==========================================
# File storage
# ==========================================
# Leave USE_S3_STORAGE unset/False for local dev (documents/avatars
# save to ./media on local disk). Set to True in production - a
# free-tier host's local disk does not survive a restart/redeploy. See
# DEPLOYMENT.md for creating a Supabase Storage bucket + S3 credentials.

USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1

# ==========================================
# LLM providers (Ask AI / AI Tasks / Knowledge Graph extraction)
# ==========================================
# Only one provider needs a key to get a working deployment -
# OPENROUTER_API_KEY (the default primary) or GROQ_API_KEY are both
# free-tier-capable and the fastest to get working; GEMINI_API_KEY also
# has a free tier. LLM_FALLBACK_ENABLED=True tries the others in order
# if the primary fails - leave False for strict "this provider, or a
# clear error" behavior. See RAG/services/llm_client.py's
# PROVIDER_REGISTRY for current free-tier model recommendations per
# provider.

LLM_PROVIDER=openrouter
LLM_FALLBACK_ENABLED=False
LLM_REQUEST_TIMEOUT=30
LLM_MAX_RETRIES=1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# ==========================================
# Background task pool (document processing + AI Tasks)
# ==========================================
# No Redis/Celery - see RAG/services/task_runner.py. Keep this at 1 on
# a free-tier host's shared/limited CPU (e.g. Render free's 0.1 CPU) -
# more threads just context-switch against each other rather than
# doing more real work, and each embedding/reranker model load costs
# real RAM per thread that's actually using one.
BACKGROUND_WORKER_THREADS=1

# False = document upload processes inline (extract/chunk/embed) during
# the request; True = it's dispatched to the background pool and the
# request returns immediately. Recommended True in production - a large
# PDF's inline processing time risks the platform's request timeout.
ENABLE_ASYNC_PROCESSING=True

AI_TASKS_MAX_DOCUMENTS=100

# ==========================================
# Email (signup OTP verification, password reset, notifications)
# ==========================================
# Leave EMAIL_HOST blank for local dev - mail prints to the console
# instead of actually sending (settings.py's EMAIL_BACKEND branches on
# this). See DEPLOYMENT.md for a genuinely free SMTP option.

SITE_URL=http://localhost:8000
SITE_NAME=Cortex

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Cortex <no-reply@example.com>

# ==========================================
# Logging
# ==========================================

DJANGO_LOG_LEVEL=INFO
DJANGO_FRAMEWORK_LOG_LEVEL=WARNING

# ==========================================
# Retrieval / RAG pipeline tuning
# ==========================================
# All optional - sensible defaults are baked into settings.py. Every
# one of these is also editable at runtime from Admin > Settings
# without a redeploy (RAG/services/system_config_service.py); .eee only
# sets the starting value.

TOP_K=3
EMBEDDING_MODEL=all-MiniLM-L6-v2

ENABLE_QUERY_EXPANSION=False
ENABLE_HYDE=False
ENABLE_MULTI_QUERY=False
MULTI_QUERY_VARIANTS=3
ENABLE_DYNAMIC_TOP_K=True
DYNAMIC_TOP_K_MAX=10

# Reranking costs a real local model inference pass per question -
# see the "Free-tier resource limits" section of DEPLOYMENT.md before
# enabling this on Render's free tier (512MB RAM).
ENABLE_RERANKER=False
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATE_MULTIPLIER=3
RERANKER_MAX_LENGTH=320
RERANKER_BATCH_SIZE=32

ENABLE_CONTEXT_COMPRESSION=False
CONTEXT_COMPRESSION_THRESHOLD=0.92

RETRIEVAL_CACHE_TTL=120
MAX_CONTEXT_CHARS=12000

ANSWER_TEMPERATURE=0.2
ANSWER_MAX_TOKENS=1024

# ==========================================
# Sessions
# ==========================================

REMEMBER_ME_SESSION_AGE=2592000
